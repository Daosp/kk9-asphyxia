//-
  You can include your own stylesheet
link(rel='stylesheet' href='static/css/profile_name.css')
link(rel='stylesheet' href='static/css/profile_customize.css')

.content
  section.section.customize-page#profile-customization(data-profile-refid=refid)
    .customize-title
      h2 Visual Customization

    .customize-layout
      aside.customize-preview
        .customize-preview-heading
          h3 Preview
          button.customize-reset(type="button" id="customize-reset") Reset preview
        p#profile-selection-status.customize-set-preview(role="status" aria-live="polite") Detecting signed-in profile...

        .customize-preview-board(data-customize-preview="table hai")
          h4 Table Background & Tiles
          .customize-board-images
            img#customize-preview-table(src='static/img/table/table/' + (custom && custom.table ? custom.table : '6000000') + '.webp' alt="Table background preview")
            img#customize-preview-hai(src='static/img/table/hai/' + (custom && custom.hai ? custom.hai : '5000000') + '.webp' alt="Tile preview")

        .customize-preview-panel(data-customize-preview="panel medal" hidden)
          h4 Player Panel
          .customize-panel-images
            img.panel-corner1(src='static/img/panel/corner/' + (custom && custom.corner ? custom.corner : '2000000') + '_num1.webp' alt="")
            img.panel-corner2(src='static/img/panel/corner/' + (custom && custom.corner ? custom.corner : '2000000') + '_num2.webp' alt="")
            img.panel-corner3(src='static/img/panel/corner/' + (custom && custom.corner ? custom.corner : '2000000') + '_num3.webp' alt="")
            img.panel-corner4(src='static/img/panel/corner/' + (custom && custom.corner ? custom.corner : '2000000') + '_num4.webp' alt="")
            img.panel-side1(src='static/img/panel/midle/' + (custom && custom.midle ? custom.midle : '3000000') + '_num1.webp' alt="")
            img.panel-side2(src='static/img/panel/midle/' + (custom && custom.midle ? custom.midle : '3000000') + '_num2.webp' alt="")
            img.panel-side3(src='static/img/panel/midle/' + (custom && custom.midle ? custom.midle : '3000000') + '_num3.webp' alt="")
            img.panel-side4(src='static/img/panel/midle/' + (custom && custom.midle ? custom.midle : '3000000') + '_num4.webp' alt="")
            img.panel-center(src='static/img/panel/base/' + (custom && custom.base ? custom.base : '1000000') + '.webp' alt="")
            - for (let slot = 0; slot < 8; slot++)
              - const medalId = selectedMedals[slot]
              img(class='panel-medal medal-' + (slot + 1) src='static/img/medals/' + medalId + '.webp' alt=(names[medalId] || 'Medal ' + medalId) hidden=!medalId data-medal-preview=slot)

        .customize-preview-board(data-customize-preview="call" hidden)
          h4 Call
          .customize-board-images
            img#customize-preview-call(src='static/img/irodori/call/' + (custom && custom.call ? custom.call : '7000000') + '.webp' alt="Call preview")
            
        .customize-preview-board(data-customize-preview="comment" hidden)
          h4 Comment
          .customize-board-images
            img#customize-preview-comment(src='static/img/irodori/comment/' + (custom && custom.comment ? custom.comment : '8000000') + '.webp' alt="Comment preview")
        
        .customize-preview-board(data-customize-preview="movebg" hidden)
          h4 Animated table
          .customize-board-images
            img#customize-preview-movebg(src='static/img/gouka-movebg/' + (custom && custom.movebg ? custom.movebg : '9000000') + '.webp' alt="Anitable preview")

      .customize-selector
        nav.customize-categories(role="tablist" aria-label="Customization categories")
          button.customize-category.is-active(type="button" role="tab" aria-selected="true" data-customize-tab="table") Table
          button.customize-category(type="button" role="tab" aria-selected="false" data-customize-tab="hai") Tiles
          button.customize-category(type="button" role="tab" aria-selected="false" data-customize-tab="panel") Pl. Panel
          button.customize-category(type="button" role="tab" aria-selected="false" data-customize-tab="medal") Medals
          button.customize-category(type="button" role="tab" aria-selected="false" data-customize-tab="call") Call
          button.customize-category(type="button" role="tab" aria-selected="false" data-customize-tab="comment") Comm
          button.customize-category(type="button" role="tab" aria-selected="false" data-customize-tab="movebg") Anitable (ONLY HG)

        form#custom-settings(method='post' data-page-refid=refid)
          input(type='hidden' name='refid' value=refid)
          input(type='hidden' name='collection' value='custom')
          input#customize-custom-id(type='hidden' name='customId' value=(custom && custom.customId ? custom.customId : '1'))
          input#customize-value-call(type='hidden' name='call' value=(custom && custom.call ? custom.call : '7000000'))
          input#customize-value-comment(type='hidden' name='comment' value=(custom && custom.comment ? custom.comment : '8000000'))
          input#customize-value-movebg(type='hidden' name='movebg' value=(custom && custom.movebg ? custom.movebg : '9000000'))
          input#customize-value-table(type='hidden' name='table' value=(custom && custom.table ? custom.table : '6000000'))
          input#customize-value-hai(type='hidden' name='hai' value=(custom && custom.hai ? custom.hai : '5000000'))
          input#customize-value-base(type='hidden' name='base' value=(custom && custom.base ? custom.base : '1000000'))
          input#customize-value-corner(type='hidden' name='corner' value=(custom && custom.corner ? custom.corner : '2000000'))
          input#customize-value-midle(type='hidden' name='midle' value=(custom && custom.midle ? custom.midle : '3000000'))
          input#customize-medal-values(type='hidden' name='medals' value=JSON.stringify(selectedMedals))

          .customize-category-content#customize-table-panel(data-customize-panel="table")
            .customize-page-links
              button(type="button" data-page-prev disabled) Previous
              span.is-current(data-page-status) Page 1
              button(type="button" data-page-next) Next
            .customize-item-list
              table.customize-items
                thead
                  tr
                    th.customize-item-image Image
                    th.customize-item-details Part name
                    th.customize-item-status Game setting
                    th.customize-item-action Action
                tbody
                  each i in table
                    tr(data-customize-row="table")
                      td.customize-item-image
                        img(src='static/img/table/table/' + i + '.webp' alt=(names[i] || 'Table ' + i))
                      td.customize-item-details
                        strong= names[i] || 'Table ' + i
                        p Item ID: #{i}
                      td.customize-item-status
                      td.customize-item-action
                        button.customize-preview-button(type="button" data-customize-select="table" data-item-id=i data-item-image='static/img/table/table/' + i + '.webp' aria-pressed=String(i) === String(custom && custom.table ? custom.table : '6000000'))
                          | Preview

          .customize-category-content#customize-hai-panel(data-customize-panel="hai" hidden)
            .customize-item-list
              table.customize-items
                thead
                  tr
                    th.customize-item-image Image
                    th.customize-item-details Part name
                    th.customize-item-status Game setting
                    th.customize-item-action Action
                tbody
                  each i in hai
                    tr
                      td.customize-item-image
                        img(src='static/img/table/hai/' + i + '.webp' alt=(names[i] || 'Tile set ' + i))
                      td.customize-item-details
                        strong= names[i] || 'Tile set ' + i
                        p Item ID: #{i}
                      td.customize-item-status
                      td.customize-item-action
                        button.customize-preview-button(type="button" data-customize-select="hai" data-item-id=i data-item-image='static/img/table/hai/' + i + '.webp' aria-pressed=String(i) === String(custom && custom.hai ? custom.hai : '5000000'))
                          | Preview

          .customize-category-content#customize-panel-panel(data-customize-panel="panel" hidden)
            h4.customize-part-title Panel Base
            .customize-item-list
              table.customize-items
                tbody
                  each i in base
                    tr
                      td.customize-item-image
                        img(src='static/img/panel/base/' + i + '.webp' alt=(names[i] || 'Panel base ' + i))
                      td.customize-item-details
                        strong= names[i] || 'Panel base ' + i
                        p Item ID: #{i}
                      td.customize-item-status
                      td.customize-item-action
                        button.customize-preview-button(type="button" data-customize-select="base" data-item-id=i data-item-image='static/img/panel/base/' + i + '.webp' aria-pressed=String(i) === String(custom && custom.base ? custom.base : '1000000'))
                          | Preview
            h4.customize-part-title Panel Corners
            .customize-item-list
              table.customize-items
                tbody
                  each i in corner
                    tr
                      td.customize-item-image
                        img(src='static/img/panel/corner/' + i + '_num1.webp' alt=(names[i] || 'Panel corners ' + i))
                      td.customize-item-details
                        strong= names[i] || 'Panel corners ' + i
                        p Item ID: #{i}
                      td.customize-item-status
                      td.customize-item-action
                        button.customize-preview-button(type="button" data-customize-select="corner" data-item-id=i aria-pressed=String(i) === String(custom && custom.corner ? custom.corner : '2000000'))
                          | Preview
            h4.customize-part-title Panel Sides
            .customize-item-list
              table.customize-items
                tbody
                  each i in midle
                    tr
                      td.customize-item-image
                        img(src='static/img/panel/midle/' + i + '_num1.webp' alt=(names[i] || 'Panel sides ' + i))
                      td.customize-item-details
                        strong= names[i] || 'Panel sides ' + i
                        p Item ID: #{i}
                      td.customize-item-status
                      td.customize-item-action
                        button.customize-preview-button(type="button" data-customize-select="midle" data-item-id=i aria-pressed=String(i) === String(custom && custom.midle ? custom.midle : '3000000'))
                          | Preview

          .customize-category-content#customize-medal-panel(data-customize-panel="medal" hidden)
            .customize-medal-selection
              h4.customize-part-title Medal Display
              p Select a slot, choose a medal, then save the customization to persist your choices.
              .customize-medal-slots
                - for (let slot = 0; slot < 8; slot++)
                  - const medalId = selectedMedals[slot] || ''
                  .customize-medal-slot(data-medal-slot=slot data-medal-id=medalId)
                    button.customize-medal-slot-select(type="button" data-medal-slot-select=slot aria-pressed=String(slot === 0))
                      span Slot #{slot + 1}
                      img(data-medal-slot-image=slot src='static/img/medals/' + medalId + '.webp' alt=(names[medalId] || 'Medal ' + medalId) hidden=!medalId)
                      span(data-medal-slot-label=slot)= medalId ? (names[medalId] || 'Medal ' + medalId) : 'Empty'
                    button.customize-medal-clear(type="button" data-medal-clear=slot disabled=!medalId) Clear
              p#customize-medal-status(aria-live="polite") Slot 1 selected
              .customize-medal-grid
                each i in medalItems
                  button.customize-medal-choice(type="button" data-medal-choice=i aria-pressed=String(selectedMedals.includes(i)))
                    img(src='static/img/medals/' + i + '.webp' alt=(names[i] || 'Medal ' + i))
                    span= names[i] || 'Medal ' + i
                    small Item ID: #{i}

          .customize-category-content#customize-call-panel(data-customize-panel="call" hidden)
            .customize-item-list
              table.customize-items
                thead
                  tr
                    th.customize-item-image Image
                    th.customize-item-details Part name
                    th.customize-item-status Game setting
                    th.customize-item-action Action
                tbody
                  each i in call
                    tr
                      td.customize-item-image
                        img(src='static/img/irodori/call/' + i + '.webp' alt=(names[i] || 'Call' + i))
                      td.customize-item-details
                        strong= names[i] || 'Call ' + i
                        p Item ID: #{i}
                      td.customize-item-status
                      td.customize-item-action
                        button.customize-preview-button(type="button" data-customize-select="call" data-item-id=i data-item-image='static/img/irodori/call/' + i + '.webp' aria-pressed=String(i) === String(custom && custom.call ? custom.call : '7000000'))
                          | Preview

          .customize-category-content#customize-comment-panel(data-customize-panel="comment" hidden)
            .customize-item-list
              table.customize-items
                thead
                  tr
                    th.customize-item-image Image
                    th.customize-item-details Part name
                    th.customize-item-status Game setting
                    th.customize-item-action Action
                tbody
                  each i in comment
                    tr
                      td.customize-item-image
                        img(src='static/img/irodori/comment/' + i + '.webp' alt=(names[i] || 'Comment ' + i))
                      td.customize-item-details
                        strong= names[i] || 'Comment ' + i
                        p Item ID: #{i}
                      td.customize-item-status
                      td.customize-item-action
                        button.customize-preview-button(type="button" data-customize-select="comment" data-item-id=i data-item-image='static/img/irodori/comment/' + i + '.webp' aria-pressed=String(i) === String(custom && custom.comment ? custom.comment : '8000000'))
                          | Preview

          .customize-category-content#customize-movebg-panel(data-customize-panel="movebg" hidden)
            .customize-item-list
              table.customize-items
                thead
                  tr
                    th.customize-item-image Image
                    th.customize-item-details Part name
                    th.customize-item-status Game setting
                    th.customize-item-action Action
                tbody
                  each i in movebg
                    tr
                      td.customize-item-image
                        img(src='static/img/gouka-movebg/' + i + '.webp' alt=(names[i] || 'Anitable' + i))
                      td.customize-item-details
                        strong= names[i] || 'Anitable ' + i
                        p Item ID: #{i}
                      td.customize-item-status
                      td.customize-item-action
                        button.customize-preview-button(type="button" data-customize-select="movebg" data-item-id=i data-item-image='static/img/gouka-movebg/' + i + '.webp' aria-pressed=String(i) === String(custom && custom.movebg ? custom.movebg : '9000000'))
                          | Preview

          .field
            .control
              button.button.is-primary(type='submit' disabled) Save
          p#custom-save-status(aria-live='polite')

script(src='static/js/profile_name.js')