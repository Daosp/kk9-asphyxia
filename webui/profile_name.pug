//-
  You can include your own stylesheet
link(rel='stylesheet' href='static/css/profile_name.css')

div
  h3 Customization
  section.section
    form#custom-settings(method='post')
      input(type='hidden' name='refid' value=refid)
      input(type='hidden' name='collection' value='custom')
      input(type='hidden' name='call' value='7000000')
      input(type='hidden' name='comment' value='8000000')
      input(type='hidden' name='movebg' value='9000000')
      .field
        label.label Customization ID
        .control
          input.input(type='text' name='name', value=custom.customId)
      .field
        label.label Hai (tiles)
        .control
          .select
            select(name='hai', id='hai')
              each i in hai
                option(selected=(i==custom.hai) value=i) #{names[i]}
      .field
        label.label Table
        .control
          .select
            select(name='table', id='table')
              each i in table 
                option(selected=(i==custom.table) value=i) #{names[i]}
      .field
        label.label base
        .control
          .select
            select(name='base', id='base')
              each i in base 
                option(selected=(i==custom.base) value=i) #{names[i]}
      .field
        label.label corner
        .control
          .select
            select(name='corner', id='corner')
              each i in corner 
                option(selected=(i==custom.corner) value=i) #{names[i]}
      .field
        label.label midle
        .control
          .select
            select(name='midle', id='midle')
              each i in midle 
                option(selected=(i==custom.midle) value=i) #{names[i]}
      .field
        .control
          button.button.is-primary(type='submit') Save
      p#custom-save-status(aria-live='polite')

script(src='static/js/custom_page.js')