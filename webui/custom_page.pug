.content
  h3 Club Page

  section.section
    h4.title.is-4 Club
    form#shop-settings
      input(type='hidden' name='loc_id' value='ea')
      input(type='hidden' name='exist' value=true)
      .field
        label.label(for='shop-name') Название
        .control
          input.input#shop-name(type='text' name='name' maxlength='64' value=(shop.name))
      .field
        label.label(for='shop-area') Регион
        .control
          .select
            select(name='area', id='area')
              each i in prefecture 
                option(selected=(i==shop.area)) #{i}
      .field
        label.label(for='shop-comment1') Комментарий 1
        .control
          input.input#shop-comment1(type='text' name='comment1' maxlength='128' value=(shop.comment1))
      .field
        label.label(for='shop-comment2') Комментарий 2
        .control
          input.input#shop-comment2(type='text' name='comment2' maxlength='128' value=(shop.comment2))
      .field
        label.label(for='shop-comment3') Комментарий 3
        .control
          input.input#shop-comment3(type='text' name='comment3' maxlength='128' value=(shop.comment3))
      .field
        .control
          button.button.is-primary(type='submit') Сохранить
      p#shop-save-status(aria-live='polite')

